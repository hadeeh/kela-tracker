// Kela Tracker schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  hostEmail String
  createdAt DateTime @default(now())

  members   RoomMember[]
  incidents KelaIncident[]
  sounds    CustomSound[]
  mugshots  Mugshot[]
}

model RoomMember {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  email       String
  name        String
  ratePerKela Int      @default(50)
  role        String?
  status      String   @default("approved")
  joinedAt    DateTime @default(now())

  incidents  KelaIncident[] @relation("AccusedMember")
  votes      Vote[]
  accusedBy  KelaIncident[] @relation("Accuser")

  @@unique([roomId, email])
  @@index([roomId])
}

model KelaIncident {
  id            String   @id @default(cuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String
  user          RoomMember @relation("AccusedMember", fields: [userId], references: [id], onDelete: Cascade)
  accusedById   String
  accusedBy     RoomMember @relation("Accuser", fields: [accusedById], references: [id], onDelete: Cascade)
  reason        String?
  defense       String?  // accused's "last words" defense (required for vote to start)
  defenseDeadline DateTime? // deadline for accused to submit defense
  status        String   @default("voting") // "awaiting_defense" | "voting" | "cancelled" | "completed"
  votesYes      Int      @default(0)
  votesNo       Int      @default(0)
  verdict       String   @default("pending")
  rateAtTime    Int      @default(50)
  paidAmount    Int      @default(0)
  settledAt     DateTime?
  photoId       String?
  photo         Mugshot? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  votes         Vote[]

  @@index([roomId])
  @@index([createdAt])
}

model Vote {
  id          String   @id @default(cuid())
  incidentId  String
  incident    KelaIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  voterId     String
  voter       RoomMember @relation(fields: [voterId], references: [id], onDelete: Cascade)
  choice      String
  createdAt   DateTime @default(now())

  @@unique([incidentId, voterId])
  @@index([incidentId])
}

model Mugshot {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploaderId      String  // who uploaded the photo
  targetMemberId  String? // who the photo is OF (the kela eater)
  incidentId      String?
  data            Bytes
  mimeType        String
  caption         String?
  createdAt       DateTime @default(now())

  incidents       KelaIncident[]

  @@index([roomId])
  @@index([targetMemberId])
}

model CustomSound {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  soundType String
  data      Bytes
  mimeType  String
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, soundType])
  @@index([roomId])
}
