// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  ratePerKela  Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  incidents    KelaIncident[] @relation("AccusedUser")
  votes        Vote[]
}

model KelaIncident {
  id        String   @id @default(cuid())
  userId    String   // the accused user
  user      User     @relation("AccusedUser", fields: [userId], references: [id])
  reason    String?
  accusedBy String   // user id who initiated the vote
  votesYes  Int      @default(0)  // kela votes
  votesNo   Int      @default(0)  // saeb votes
  verdict   String   @default("pending") // "kela" | "saeb" | "tie" | "pending"
  createdAt DateTime @default(now())

  votes     Vote[]

  @@index([userId])
  @@index([createdAt])
}

model Vote {
  id          String   @id @default(cuid())
  incidentId  String
  incident    KelaIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  voterId     String
  voter       User     @relation(fields: [voterId], references: [id])
  choice      String   // "kela" | "saeb"
  createdAt   DateTime @default(now())

  @@unique([incidentId, voterId])
  @@index([incidentId])
}
