// Kela Tracker schema — no auth. One person creates a Room, gets an invite code,
// friends join with name + email (no password). All data scoped to a room.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique // short shareable code, e.g. "KELA-7H3K2"
  name      String
  hostEmail String
  createdAt DateTime @default(now())

  members   RoomMember[]
  incidents KelaIncident[]
  sounds    CustomSound[]
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  email     String
  name      String
  ratePerKela Int    @default(50)
  role      String?  // "minister" = Kela Minister (can manage sounds), null = regular member
  status    String   @default("approved") // "approved" | "pending" | "rejected"
  joinedAt  DateTime @default(now())

  incidents  KelaIncident[] @relation("AccusedMember")
  votes      Vote[]
  accusedBy  KelaIncident[] @relation("Accuser")

  @@unique([roomId, email])
  @@index([roomId])
}

model KelaIncident {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String   // the accused member
  user       RoomMember @relation("AccusedMember", fields: [userId], references: [id], onDelete: Cascade)
  accusedById String   // member id who initiated the vote
  accusedBy  RoomMember @relation("Accuser", fields: [accusedById], references: [id], onDelete: Cascade)
  reason     String?
  votesYes   Int      @default(0)  // kela votes
  votesNo    Int      @default(0)  // saeb votes
  verdict    String   @default("pending") // "kela" | "saeb" | "tie" | "pending"
  rateAtTime Int      @default(50) // the accused's rate per kela WHEN this incident was created (historical)
  paidAmount Int      @default(0) // how much has been paid (in PKR)
  settledAt  DateTime?
  mugshotId  String?  // link to Mugshot record (if uploaded)
  mugshot    Mugshot? @relation(fields: [mugshotId], references: [id], onDelete: Set Null)
  createdAt  DateTime @default(now())

  votes      Vote[]

  @@index([roomId])
  @@index([createdAt])
}

model Vote {
  id          String   @id @default(cuid())
  incidentId  String
  incident    KelaIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  voterId     String
  voter       RoomMember @relation(fields: [voterId], references: [id], onDelete: Cascade)
  choice      String   // "kela" | "saeb"
  createdAt   DateTime @default(now())

  @@unique([incidentId, voterId])
  @@index([incidentId])
}

// Mugshots uploaded when someone is found guilty — stored in the Hall of Shame.
model Mugshot {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploaderId String  // member who uploaded (usually the guilty person or minister)
  incidentId String? // optional: linked to a specific incident
  data      Bytes    // the image file bytes
  mimeType  String
  caption   String?  // funny caption
  createdAt DateTime @default(now())

  incidents KelaIncident[]

  @@index([roomId])
}

// Custom sounds uploaded by the Kela Minister — stored in the database so they
// work on serverless platforms (Vercel, Render, etc.) where the filesystem is
// read-only.
model CustomSound {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  soundType String   // "vote-start" | "kela-vote" | "saeb-vote"
  data      Bytes    // the audio file bytes
  mimeType  String
  fileName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, soundType])
  @@index([roomId])
}

